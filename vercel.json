{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "uploads/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/robots\\.txt$", "dest": "/server.js" },
    {
      "src": "^/(styles\\.css|ads\\.txt|default-news-photo\\.jpg|logo-jks\\.svg|logo\\.svg|myphoto\\.jpg|og-banner-jks\\.svg|og-banner\\.svg)$",
      "dest": "/public/$1",
      "headers": { "cache-control": "public, max-age=604800, s-maxage=604800" }
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/uploads/$1",
      "headers": { "cache-control": "public, max-age=604800, s-maxage=604800" }
    },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/fetch-rss",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/generate-daily-article",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-aaj-ka-itihas",
      "schedule": "30 6 * * *"
    }
  ]
}
